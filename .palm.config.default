################################################################################
# This is a configuration file for PALM. It must be named: .palm.config.<suffix>
# in order to use it, call palmbuild and palmrun with the option: -h <suffix>
################################################################################
#
#-------------------------------------------------------------------------------
# General compiler and host configuration section.
# Variable declaration lines must start with a percent character
# Internal variables can be used as {{VARIABLE_NAME}}. Please see documentation.
#-------------------------------------------------------------------------------
%base_directory      /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm
%base_data           /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/JOBS
%source_path         /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/packages/palm/model/src
%user_source_path    /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/JOBS/$run_identifier/USER_CODE
%fast_io_catalog     /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/tmp
%restart_data_path   /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/tmp
%output_data_path    /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/JOBS
%local_jobcatalog    /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/JOBS/$run_identifier/LOG_FILES
#%remote_jobcatalog   <path/to/directory>
#
%local_ip            127.0.0.1
%local_hostname      licca001
%local_username      vaithisa
#
#%remote_ip           <ip>
#%remote_hostname     <hostname>
#%remote_loginnode    <loginnode>
#%remote_username     <username>
#%ssh_key             ~/.ssh/id_rsa
#
%defaultqueue        default
#%project_account     <project-account>
%submit_command      sbatch
#
%c_compiler_name     /hpc/gpfs2/sw/intel/oa/2024.2.1/mpi/2021.13/bin/mpiicx
%compiler_name       /hpc/gpfs2/sw/intel/oa/2024.2.1/mpi/2021.13/bin/mpiifx
%compiler_name_ser   /hpc/gpfs2/sw/intel/oa/2024.2.1/mpi/2021.13/bin/mpiifx
%cpp_options         -fpp -D__intel_compiler -D__parallel -DMPI_REAL=MPI_DOUBLE_PRECISION -DMPI_2REAL=MPI_2DOUBLE_PRECISION -D__netcdf -D__fftw -D__rrtmg
%make_options        -j 128
%c_compiler_options  
# %compiler_options    -O3 -fp-model source -fno-alias -fpe0  -ftz -no-prec-div -nbs -diag-disable 8290,8291 -I /hpc/gpfs2/home/g/mmbees/spack/v1.0.2/opt/spack/linux-zen3/netcdf-fortran-4.6.1-5ozgrbulunqpufxxcai3ptva4b7jmi4b/include -I /hpc/gpfs2/home/g/mmbees/spack/v1.0.2/opt/spack/linux-zen3/fftw-3.3.10-xz2w6lplr2nkznqeixoukmvoe6zmyjs2/include -I /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/rrtmg/include
 #%linker_options      -O3 -fp-model source -fno-alias -fpe0  -ftz -no-prec-div -nbs -diag-disable 8290,8291 /hpc/gpfs2/home/g/mmbees/spack/v1.0.2/opt/spack/linux-zen3/netcdf-fortran-4.6.1-5ozgrbulunqpufxxcai3ptva4b7jmi4b/lib/libnetcdff.so /hpc/gpfs2/home/g/mmbees/spack/v1.0.2/opt/spack/linux-zen3/fftw-3.3.10-xz2w6lplr2nkznqeixoukmvoe6zmyjs2/lib/libfftw3.so /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/rrtmg/lib/librrtmg.so

%compiler_options    -O3 -g -traceback -fp-model source -fno-alias -fpe0 -ftz -no-prec-div -nbs -diag-disable 8290,8291 -I /hpc/gpfs2/home/g/mmbees/spack/v1.0.2/opt/spack/linux-zen3/netcdf-fortran-4.6.1-5ozgrbulunqpufxxcai3ptva4b7jmi4b/include -I /hpc/gpfs2/home/g/mmbees/spack/v1.0.2/opt/spack/linux-zen3/fftw-3.3.10-xz2w6lplr2nkznqeixoukmvoe6zmyjs2/include -I /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/rrtmg/include

%linker_options      -O3 -g -traceback -fp-model source -fno-alias -fpe0 -ftz -no-prec-div -nbs -diag-disable 8290,8291 /hpc/gpfs2/home/g/mmbees/spack/v1.0.2/opt/spack/linux-zen3/netcdf-fortran-4.6.1-5ozgrbulunqpufxxcai3ptva4b7jmi4b/lib/libnetcdff.so /hpc/gpfs2/home/g/mmbees/spack/v1.0.2/opt/spack/linux-zen3/fftw-3.3.10-xz2w6lplr2nkznqeixoukmvoe6zmyjs2/lib/libfftw3.so /hpc/gpfs2/scratch/u/vaithisa/palm_mbees/palm/rrtmg/lib/librrtmg.so
%execute_command     srun --mpi=pmi2 --distribution=arbitrary --kill-on-bad-exit ./palm
%memory              5000
%module_commands     module load intel/2024.2.1 impi fftw flex netcdf-c netcdf-fortran python-mbees bison cmake hdf5 openssl
#%login_init_cmd      .execute_special_profile
#
#-------------------------------------------------------------------------------
# Directives to be used for batch jobs
# Lines must start with "BD:". If $-characters are required, hide them with \
# Internal variables can be used as {{variable_name}}. Please see documentation.
#-------------------------------------------------------------------------------
BD:#!/bin/bash -l
BD:#SBATCH --partition=epyc
#BD:#SBATCH --exclusive
BD:#SBATCH --output={{job_protocol_file}}
BD:#SBATCH --error={{job_protocol_file}}
BD:#SBATCH --job-name={{run_id}}
BD:#SBATCH --ntasks={{mpi_tasks}}
BD:#SBATCH --nodes={{nodes}}
BD:#SBATCH --ntasks-per-node={{tasks_per_node}}
BD:#SBATCH --mem-per-cpu=5000
BD:#SBATCH --mail-type=FAIL
BD:#SBATCH --mail-user=sathish.vaithiyanadhan@uni-a.de
BD:#SBATCH --time={{cpu_hours}}:{{cpu_minutes}}:{{cpu_seconds}}

#
#-------------------------------------------------------------------------------
# Directives for batch jobs used to send back the jobfiles from a remote to a local host
# Lines must start with "BDT:". If $-characters are required, excape them with triple backslash
# Internal variables can be used as {{variable_name}}. Please see documentation.
#-------------------------------------------------------------------------------
#BDT:#!/bin/bash
#BDT:#PBS -A {{project_account}}
#BDT:#PBS -N job_protocol_transfer
#BDT:#PBS -l walltime=00:30:00
#BDT:#PBS -l nodes=1:ppn=1
#BDT:#PBS -o {{job_transfer_protocol_file}}
#BDT:#PBS -j oe
#BDT:#PBS -q dataq
#
#-------------------------------------------------------------------------------
# INPUT-commands. These commands are executed before running PALM
# Lines must start with "IC:"
#-------------------------------------------------------------------------------
IC:module load intel/2024.2.1 impi fftw flex netcdf-c netcdf-fortran python-mbees bison cmake hdf5 openssl
IC:export LD_LIBRARY_PATH=$(pkg-config netcdf-fortran --variable=libdir):$LD_LIBRARY_PATH
IC:export I_MPI_FABRICS=shm:ofi
IC:export I_MPI_SHM_OPT=shm
IC:export FI_PROVIDER=mlx
IC:export FI_TCP_IFACE=eth5
 IC:ulimit  -s unlimited
IC:srun hostname -s | sort -n > slurm.hosts
IC:export SLURM_HOSTFILE=slurm.hosts

#
#-------------------------------------------------------------------------------
# ERROR-commands. These commands are executed when PALM terminates abnormally
# Lines must start with "EC:"
#-------------------------------------------------------------------------------
EC:[[ $locat = execution ]]  &&  cat  RUN_CONTROL
#
#-------------------------------------------------------------------------------
# OUTPUT-commands. These commands are executed when PALM terminates normally
# Lines must start with "OC:"
#-------------------------------------------------------------------------------
#
# Combine 1D- and 3D-profile output (these files are not usable for plotting)
OC:[[ -f LIST_PROFIL_1D     ]]  &&  cat  LIST_PROFIL_1D  >>  LIST_PROFILE
OC:[[ -f LIST_PROFIL        ]]  &&  cat  LIST_PROFIL     >>  LIST_PROFILE
#
# Combine all particle information files
OC:[[ -f PARTICLE_INFOS/_0000 ]]  &&  cat  PARTICLE_INFOS/* >> PARTICLE_INFO
